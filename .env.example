# Next.js server-only configuration
N8N_WEBHOOK_URL=
N8N_API_SECRET=
N8N_REQUEST_TIMEOUT_MS=12000

# Product configuration
SESSION_RUN_LIMIT=4
DEFAULT_LOCALE=en
IP_RATE_LIMIT_MAX=20
IP_RATE_LIMIT_WINDOW_SECONDS=3600

# Public configuration
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_MOCK_MODE=true

# Keep these values in n8n credentials/configuration, not in the Next.js client:
# OPENROUTER_API_KEY
# OPENROUTER_MODEL=google/gemini-2.5-flash
# TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID
# GOOGLE_SHEETS_CREDENTIAL
# GOOGLE_SPREADSHEET_ID
# GOOGLE_SHEET_NAME

